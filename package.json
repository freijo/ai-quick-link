{
  "name": "ai-quick-link",
  "version": "1.4.0",
  "description": "AI Quick View Chrome Extension",
  "manifest_version": 3,
  "scripts": {
    "test": "jest",
    "test:e2e": "jest --config=jest.e2e.config.js",
    "build": "webpack --mode=production",
    "dev": "webpack --mode=development --watch",
    "lint": "eslint .",
    "pack": "npm run build && zip -r dist/ai-quick-link-v${npm_package_version}.zip dist/ -x 'node_modules/*'",
    "validate": "node scripts/validate-manifest.js"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.0",
    "eslint": "^8.57.0",
    "puppeteer": "^22.6.1"
  },
  "browserslist": ["chrome >= 96"]
}